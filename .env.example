# 默认全本地：M0-M5 全部走进程内固定算法 Tool handler，无需任何外部服务
YUNPAI_TOOL_TRANSPORT=local
YUNPAI_RUN_DB=runtime/yunpai-runs.sqlite

# 可选：独立部署的模块服务（transport=http 且列入 YUNPAI_HTTP_MODULES 时才生效）
YUNPAI_HTTP_MODULES=
M0_URL=http://127.0.0.1:8010
M1_URL=http://127.0.0.1:8080
M2_URL=http://127.0.0.1:8765
# M2 外部服务自身的模型端点（编排器不消费该变量，由部署方按需注入；
# 只能指向 OpenAI-compatible Qwen 代理，例如 http://127.0.0.1:18085/v1；
# 端点不可达必须如实报 unavailable/degraded，禁止伪造模型成功）：
M2_MODEL_BASE_URL=
M2_MODEL_NAME=qwen3.6-35b-a3b-fp8-gpu0-200k
M2_API_KEY=
M3_URL=http://127.0.0.1:8000
M4_URL=http://127.0.0.1:8000
M3_API_KEY=
M4_API_KEY=
M5_URL=http://127.0.0.1:8000

# M5 计划/快照持久库（默认 runtime/yunpai-m5.sqlite，生产值由部署方注入）
YUNPAI_M5_DB=

# 审批身份：生产要求反向代理注入 X-Yunpai-Principal / X-Actor-User(+Roles/Tenant)
# 设为 1 时，/runs/{id}/resume 缺少受信头直接拒绝（403 TRUSTED_PRINCIPAL_REQUIRED）
YUNPAI_REQUIRE_TRUSTED_PRINCIPAL=0

# Planner intent/router（OpenAI-compatible 端点）。本机默认指向 llama.cpp 跑的
# Qwen3.8-27B（127.0.0.1:8088，本地无鉴权，QWEN_API_KEY 填占位即可；远端 vLLM
# 则填真实 key）。未配置 QWEN_API_KEY 时 classify 自动回退确定性路由并记录 not_configured。
QWEN_ROUTER_ENABLED=true
QWEN_BASE_URL=http://127.0.0.1:8088/v1
QWEN_MODEL=qwen3.8-27b
QWEN_API_KEY=local
QWEN_TIMEOUT_S=45
