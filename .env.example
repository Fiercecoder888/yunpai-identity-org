YUNPAI_TOOL_TRANSPORT=local
YUNPAI_RUN_DB=runtime/yunpai-runs.sqlite
M0_URL=http://m0:8010
M1_URL=http://m1:8080
M2_URL=http://m2:8765
# M2 冻结服务自身的模型端点（GB10 隔离 release 启动 M2 时由部署方注入；
# 编排器不消费该变量，但 /api/health 与工程 Gate 依赖其可达）：
#   只能指向 OpenAI-compatible Qwen 代理 http://<gb10-host>:18085/v1
#   （GB10 本机部署用 http://127.0.0.1:18085/v1）；端点不可达必须如实报
#   unavailable/degraded，禁止伪造模型成功，也严禁用 8081/11434/127.0.0.1:9 冒充。
M2_MODEL_BASE_URL=
M2_MODEL_NAME=qwen3.6-35b-a3b-fp8-gpu0-200k
M2_API_KEY=
M3_URL=http://m3:8000
M4_URL=http://m4:8000
M3_API_KEY=
M4_API_KEY=
M5_URL=http://m5-api:8000

# M5 计划/快照持久库（release 外受控路径，生产值由部署方注入）
YUNPAI_M5_DB=

# 审批身份：生产要求反向代理注入 X-Yunpai-Principal / X-Actor-User(+Roles/Tenant)
# 设为 1 时，/runs/{id}/resume 缺少受信头直接拒绝（403 TRUSTED_PRINCIPAL_REQUIRED）
YUNPAI_REQUIRE_TRUSTED_PRINCIPAL=0

# Planner intent/router (OpenAI-compatible GB10 Qwen endpoint)
QWEN_ROUTER_ENABLED=true
QWEN_BASE_URL=http://gb10:18085/v1
QWEN_MODEL=qwen3.6-35b-a3b-fp8-gpu0-200k
QWEN_API_KEY=
QWEN_TIMEOUT_S=45
