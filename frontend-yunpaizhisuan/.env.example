# Frontend demo/local defaults:
# VITE_API_BASE_URL empty + VITE_ENABLE_MSW=true enables browser MSW demo mode.
VITE_API_BASE_URL=
VITE_ENABLE_MSW=true

# Real frontend/backend E2E defaults:
# Do not put API keys, database passwords, tokens, or other secrets in this file.
FRONTEND_REAL_E2E_PORT=18080
API_GATEWAY_PORT=8088
ORCH_HOST_PORT=19000
API_GATEWAY_NETWORK=yunpaizhisuan-backend
# Dedicated M3 browser identity-proxy credential. Configure the same value on
# M3 and keep it distinct from the orchestrator-facing M3_SERVICE_TOKEN.
M3_GATEWAY_SERVICE_TOKEN=
# Dedicated M4 browser identity-proxy credential. Configure the same value on
# M4; never reuse the material-supply signing secret or orchestrator JWT.
M4_GATEWAY_SERVICE_TOKEN=
# Dedicated M5 identity-proxy key injected by the API Gateway. Register it as a
# distinct admin,identity_proxy v2 credential; never reuse a module service key.
M5_GATEWAY_API_KEY=
# Dedicated M0 identity-proxy key. Register it with only identity_proxy; human
# permissions come from the verified Identity-BFF role headers.
M0_GATEWAY_API_KEY=

# Frontend image built by docker-compose.real-e2e.yml.
FRONTEND_IMAGE=yunpaizhisuan-fe:real-e2e

# Real backend images must be supplied by the backend delivery or local image build.
# The frontend repository does not contain backend source or private runtime secrets.
ORCHESTRATOR_IMAGE=yunpaizhisuan-orchestrator:real-e2e
M1_IMAGE=yunpaizhisuan-m1:real-e2e
M2_IMAGE=yunpaizhisuan-m2:real-e2e
M3_IMAGE=yunpaizhisuan-m3:real-e2e
M4_IMAGE=yunpaizhisuan-m4:real-e2e
M5_API_IMAGE=yunpaizhisuan-m5-api:real-e2e
M6_IMAGE=yunpaizhisuan-m6:real-e2e
M8_IMAGE=yunpaizhisuan-m8:real-e2e

# Archive backend real-E2E compose (`docker-compose.archive-e2e.yml`) also reads
# these variables. Leave API keys empty for health/smoke unless a private local
# .env supplies real values. Never commit real keys.
POSTGRES_USER=orch
POSTGRES_PASSWORD=orch
POSTGRES_IMAGE_TAG=15-alpine
REDIS_IMAGE_TAG=6-alpine
MEMORY_ENABLED=false
ORCH_LLM_BASE_URL=https://api.siliconflow.cn/v1
ORCH_LLM_API_KEY=
ORCH_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
VLM_API_KEY=
VLM_BASE_URL=https://api.siliconflow.cn/v1
VLM_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
M2_MODEL_BASE_URL=https://api.siliconflow.cn/v1
M2_MODEL_NAME=Qwen/Qwen2.5-72B-Instruct
M2_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
